# Local development only. Runtime accepts mock mode exclusively.
ARENA_MODE=mock
ARENA_DATABASE_URL=postgresql+psycopg://arena:arena_local@127.0.0.1:55433/arena
ARENA_REDIS_URL=redis://127.0.0.1:56379/0
ARENA_MODEL_TIMEOUT_SECONDS=1.0
ARENA_LEASE_SECONDS=15
ARENA_POLL_SECONDS=1.0
ARENA_MAX_ATTEMPTS=3
ARENA_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Tests create and drop an isolated schema, never application tables.
TEST_DATABASE_URL=postgresql+psycopg://arena:arena_local@127.0.0.1:55433/arena
